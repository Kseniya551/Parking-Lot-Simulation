void upgradeParkingLot(ParkingLot* parkingLot, int newRows, int newCols, double upgradeCost) {
    if (parkingLot->ownerMoney < upgradeCost) {
        printf("Not enough funds for upgrade!\n");
        Sleep(1000);
        return;
    }

    int newTotalSpots = newRows * newCols;
    ParkingSpot* newSpots = (ParkingSpot*)malloc(sizeof(ParkingSpot) * newTotalSpots);
    if (newSpots == NULL) {
        perror("Failed to allocate memory for new parking spots during upgrade");
        return;
    }

    for (int i = 0; i < newTotalSpots; i++) {
        newSpots[i].id = i + 1;
        newSpots[i].isOccupied = 0;
        newSpots[i].entryTime = 0;
    }

    int spotsToCopy = (parkingLot->totalSpots < newTotalSpots) ? parkingLot->totalSpots : newTotalSpots;
    for (int i = 0; i < spotsToCopy; i++) {
        if (parkingLot->spots[i].isOccupied) {
            newSpots[i] = parkingLot->spots[i];
        }
    }

    freeParkingLot(parkingLot);
    parkingLot->spots = newSpots;
    parkingLot->rows = newRows;
    parkingLot->cols = newCols;
    parkingLot->totalSpots = newTotalSpots;
    parkingLot->ownerMoney -= upgradeCost;

    printf("Parking lot successfully upgraded to %dx%d! Cost: %.2f NIS.\n", newRows, newCols, upgradeCost);
    Sleep(2000);
}

void applyMoneyCheat(ParkingLot* parkingLot) {
    parkingLot->ownerMoney += 5000;
    printf("CHEAT ACTIVATED: 5000 NIS added to owner's money! New balance: %.2f NIS\n", parkingLot->ownerMoney);
    Sleep(2000);
}

int getIntegerInput(const char* prompt) {
    int value;
    char buffer[100];

    if (prompt && strlen(prompt) > 0) {
        printf("%s", prompt);
    }

    if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
        buffer[strcspn(buffer, "\n")] = 0;
        value = atoi(buffer);
    }
    else {
        printf("Error reading input. Please try again.\n");
        value = -1;
    }
    return value;
}
